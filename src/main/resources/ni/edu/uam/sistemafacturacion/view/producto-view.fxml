<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.sistemafacturacion.controller.ProductoController">

    <top>
        <VBox styleClass="view-header">

            <Label text="Gestión de Productos"
                   styleClass="view-title"/>

            <Label text="Registro, consulta, búsqueda y filtrado de productos"
                   styleClass="view-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="view-body">
            <padding>
                <Insets top="22" right="26" bottom="26" left="26"/>
            </padding>

            <!-- FORMULARIO -->
            <VBox styleClass="card" spacing="14">

                <Label text="Datos del producto" styleClass="dash-card-title"/>

                <GridPane hgap="14" vgap="12">

                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Fila 0 -->
                    <Label text="CÓDIGO"
                           styleClass="field-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtCodigo"
                               promptText="Ej. P-001"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="NOMBRE"
                           styleClass="field-label"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre del producto"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0"/>

                    <!-- Fila 1 -->
                    <Label text="CATEGORÍA"
                           styleClass="field-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <ComboBox fx:id="cmbCategoria"
                              promptText="Seleccione una categoría"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"/>

                    <Label text="PRECIO VENTA"
                           styleClass="field-label"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtPrecioVenta"
                               promptText="0.00"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1"/>

                    <!-- Fila 2 -->
                    <Label text="EXISTENCIA"
                           styleClass="field-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="txtExistencia"
                               promptText="0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>

                    <Label text="ESTADO"
                           styleClass="field-label"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="2"/>

                    <CheckBox fx:id="chkActivo"
                              text="Producto activo"
                              selected="true"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="2"/>

                </GridPane>

                <HBox spacing="10">

                    <Button fx:id="btnNuevo"
                            text="Nuevo"
                            onAction="#nuevo"
                            styleClass="button,button-secondary"/>

                    <Button fx:id="btnActualizar"
                            text="Actualizar"
                            onAction="#actualizar"
                            styleClass="button,button-secondary"/>

                    <Button fx:id="btnEliminar"
                            text="Eliminar"
                            onAction="#eliminar"
                            styleClass="button,button-danger"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnGuardar"
                            text="Guardar"
                            onAction="#guardar"
                            styleClass="button,button-primary"/>

                </HBox>

            </VBox>

            <!-- TABLA + BÚSQUEDA + FILTROS -->
            <VBox styleClass="card"
                  spacing="12"
                  VBox.vgrow="ALWAYS">

                <Label text="Productos registrados" styleClass="dash-card-title"/>

                <HBox spacing="10">

                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por código, nombre o categoría"
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="cmbFiltroEstado"
                              prefWidth="150"/>

                    <ComboBox fx:id="cmbFiltroCategoria"
                              prefWidth="200"/>

                    <Button text="Limpiar filtros"
                            onAction="#limpiarFiltros"
                            styleClass="button,button-secondary"/>

                </HBox>

                <TableView fx:id="tblProductos"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colCodigo"
                                     text="Código"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="230"/>

                        <TableColumn fx:id="colCategoria"
                                     text="Categoría"
                                     prefWidth="160"/>

                        <TableColumn fx:id="colPrecioVenta"
                                     text="Precio"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colExistencia"
                                     text="Existencia"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colActivo"
                                     text="Activo"
                                     prefWidth="80"/>

                    </columns>

                    <placeholder>
                        <Label text="No hay productos que mostrar"/>
                    </placeholder>

                </TableView>

                <Label fx:id="lblTotal" styleClass="section-subtitle"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>
