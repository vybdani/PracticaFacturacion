<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.sistemafacturacion.controller.CategoriaController">

    <top>
        <VBox styleClass="view-header">

            <Label text="Gestión de Categorías"
                   styleClass="view-title"/>

            <Label text="Administración de las categorías de productos"
                   styleClass="view-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="view-body">
            <padding>
                <Insets top="22" right="26" bottom="26" left="26"/>
            </padding>

            <!-- FORMULARIO -->
            <VBox styleClass="card" spacing="14">

                <Label text="Datos de la categoría" styleClass="dash-card-title"/>

                <GridPane hgap="14" vgap="12">

                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="ID"
                           styleClass="field-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtId"
                               editable="false"
                               promptText="Generado automáticamente"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="NOMBRE"
                           styleClass="field-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtNombre"
                               promptText="Ingrese el nombre de la categoría"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="ESTADO"
                           styleClass="field-label"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <CheckBox fx:id="chkActiva"
                              text="Categoría activa"
                              selected="true"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                </GridPane>

                <HBox spacing="10">

                    <Button
                            text="Nuevo"
                            onAction="#nuevo"
                            styleClass="button,button-secondary"/>

                    <Button fx:id="btnActualizar"
                            text="Actualizar"
                            onAction="#actualizar"
                            styleClass="button,button-secondary"/>

                    <Button fx:id="btnEliminar"
                            text="Eliminar"
                            onAction="#eliminar"
                            styleClass="button,button-danger"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnGuardar"
                            text="Guardar"
                            onAction="#guardar"
                            styleClass="button,button-primary"/>

                </HBox>

            </VBox>

            <!-- TABLA -->
            <VBox styleClass="card"
                  spacing="12"
                  VBox.vgrow="ALWAYS">

                <Label text="Categorías registradas" styleClass="dash-card-title"/>

                <TableView fx:id="tblCategorias"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="80"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="320"/>

                        <TableColumn fx:id="colActiva"
                                     text="Activa"
                                     prefWidth="120"/>

                    </columns>

                    <placeholder>
                        <Label text="No existen categorías registradas"/>
                    </placeholder>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
