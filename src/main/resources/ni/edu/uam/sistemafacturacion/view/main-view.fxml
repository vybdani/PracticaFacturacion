<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.sistemafacturacion.controller.MainController">

    <!-- ===================== SIDEBAR ===================== -->
    <left>

        <VBox styleClass="sidebar">

            <VBox styleClass="sidebar-brand">

                <StackPane styleClass="brand-badge">
                    <Label text="SF"/>
                </StackPane>

                <VBox spacing="1">
                    <Label text="Facturación"
                           styleClass="brand-title"/>
                    <Label text="Panel de control"
                           styleClass="brand-subtitle"/>
                </VBox>

            </VBox>

            <Label text="MENÚ"
                   styleClass="nav-section-label"/>

            <VBox styleClass="nav-list">

                <Button
                        text="🗂   Categorías"
                        maxWidth="Infinity"
                        onAction="#abrirCategorias"
                        styleClass="nav-item"/>

                <Button text="📦   Productos"
                        maxWidth="Infinity"
                        onAction="#abrirProductos"
                        styleClass="nav-item"/>

                <Button text="👥   Clientes"
                        maxWidth="Infinity"
                        disable="true"
                        styleClass="nav-item"/>

                <Button text="📄   Facturación"
                        maxWidth="Infinity"
                        disable="true"
                        styleClass="nav-item"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-footer">

                <Region styleClass="sidebar-divider"/>

                <Button fx:id="btnSalir"
                        text="⏻   Salir"
                        maxWidth="Infinity"
                        onAction="#salir"
                        styleClass="nav-item"/>

                <Label text="v1.0 · JavaFX 21"
                       styleClass="sidebar-version"/>

            </VBox>

        </VBox>

    </left>


    <!-- ===================== CONTENIDO ===================== -->
    <center>

        <VBox styleClass="content-area">

            <VBox styleClass="topbar">
                <Label text="BIENVENIDA"
                       styleClass="topbar-eyebrow"/>
                <Label text="Sistema de Facturación"
                       styleClass="topbar-title"/>
                <Label text="Selecciona un módulo para comenzar a trabajar"
                       styleClass="topbar-subtitle"/>
            </VBox>

            <ScrollPane fitToWidth="true"
                        styleClass="content-scroll"
                        VBox.vgrow="ALWAYS">

                <VBox spacing="22">

                    <padding>
                        <Insets top="4" right="36" bottom="36" left="36"/>
                    </padding>

                    <VBox styleClass="hero-card" spacing="6">
                        <Label text="Gestiona tu negocio en un solo lugar"
                               styleClass="hero-title"/>
                        <Label text="Categorías, productos, clientes y facturación conectados a PostgreSQL vía JDBC."
                               styleClass="hero-text"
                               wrapText="true"/>
                    </VBox>

                    <GridPane hgap="18" vgap="18">

                        <Button onAction="#abrirCategorias"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                styleClass="dash-card"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0">
                            <graphic>
                                <VBox spacing="12">
                                    <StackPane styleClass="dash-card-icon">
                                        <Label text="🗂"/>
                                    </StackPane>
                                    <Label text="Categorías" styleClass="dash-card-title"/>
                                    <Label text="Crea y administra las categorías de productos"
                                           styleClass="dash-card-desc"/>
                                    <Label text="DISPONIBLE" styleClass="dash-card-tag"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <Button onAction="#abrirProductos"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                styleClass="dash-card"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0">
                            <graphic>
                                <VBox spacing="12">
                                    <StackPane styleClass="dash-card-icon">
                                        <Label text="📦"/>
                                    </StackPane>
                                    <Label text="Productos" styleClass="dash-card-title"/>
                                    <Label text="Inventario, precios y stock disponible"
                                           styleClass="dash-card-desc"/>
                                    <Label text="DISPONIBLE" styleClass="dash-card-tag"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <Button disable="true"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                styleClass="dash-card"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1">
                            <graphic>
                                <VBox spacing="12">
                                    <StackPane styleClass="dash-card-icon">
                                        <Label text="👥"/>
                                    </StackPane>
                                    <Label text="Clientes" styleClass="dash-card-title"/>
                                    <Label text="Directorio de clientes y datos de contacto"
                                           styleClass="dash-card-desc"/>
                                    <Label text="PRÓXIMAMENTE" styleClass="dash-card-tag,dash-card-tag-soon"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <Button disable="true"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                styleClass="dash-card"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1">
                            <graphic>
                                <VBox spacing="12">
                                    <StackPane styleClass="dash-card-icon">
                                        <Label text="📄"/>
                                    </StackPane>
                                    <Label text="Facturación" styleClass="dash-card-title"/>
                                    <Label text="Genera y consulta facturas de venta"
                                           styleClass="dash-card-desc"/>
                                    <Label text="PRÓXIMAMENTE" styleClass="dash-card-tag,dash-card-tag-soon"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                    </GridPane>

                </VBox>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
